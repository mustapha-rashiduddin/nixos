+static void
+selautoscrollupdate(XEvent *e)
+{
+	int dir = 0;
+
+	if ((buttons & 1) && !tisaltscr()) {
+		if (e->xmotion.y <= borderpx)
+			dir = 1;
+		else if (e->xmotion.y >= borderpx + win.th - 1)
+			dir = -1;
+	}
+
+	selautoscrollevent = *e;
+	if (dir != selautoscrolldir) {
+		selautoscrolldir = dir;
+		selautoscrolllast = (struct timespec){0};
+	}
+}
+
+static int
+selautoscroll(struct timespec now)
+{
+	Arg arg = {.i = 1};
+
+	if (!selautoscrolldir ||
+	    ((selautoscrolllast.tv_sec || selautoscrolllast.tv_nsec) &&
+	     TIMEDIFF(now, selautoscrolllast) < SELAUTOSCROLL_INTERVAL))
+		return 0;
+
+	if (selautoscrolldir > 0)
+		kscrollup(&arg);
+	else
+		kscrolldown(&arg);
+	mousesel(&selautoscrollevent, 0);
+	selautoscrolllast = now;
+	return 1;
+}
