+/*-
+ * Order completion candidates by how closely they match the literal text
+ * that was typed, best first, so the one the user means sits at the top of
+ * a list and do_complete() can tell a clear winner from a near tie.
+ *
+ * Only plain literal words can be ranked: a wildcard, a parameter
+ * substitution or a backslash escape has no single sensible "typed text"
+ * to score against. Returns false then, leaving the candidates in their
+ * existing (alphabetical) order.
+ */
+static bool
+x_flex_rank(int nwords, char **words, const char *query, size_t qlen)
+{
+	int *scores;
+	char **order;
+	int i, j;
+	const char *base;
+
+	if (nwords < 2 || qlen == 0)
+		return (false);
+	for (i = 0; i < (int)qlen; i++) {
+		unsigned char c = (unsigned char)query[i];
+
+		if (c == '\\' || mksh_cdirsep(c) ||
+		    ord(c) == ORD('*') || ord(c) == ORD('?') ||
+		    ord(c) == ORD('[') || ord(c) == ORD('$'))
+			return (false);
+	}
+	scores = alloc2(nwords, sizeof(*scores), ATEMP);
+	order = alloc2(nwords, sizeof(*order), ATEMP);
+	for (i = 0; i < nwords; i++) {
+		/*
+		 * Score the basename: any directory part is common to all
+		 * candidates, and x_basename() skips the trailing slash
+		 * that a directory match carries.
+		 */
+		base = words[i] + x_basename(words[i], NULL);
+		order[i] = words[i];
+		scores[i] = flex_score(base, query, qlen);
+	}
+	/* insertion sort: nwords is bounded by one directory listing */
+	for (i = 1; i < nwords; i++) {
+		char *w = order[i];
+		int sc = scores[i];
+
+		for (j = i; j > 0 && scores[j - 1] > sc; j--) {
+			order[j] = order[j - 1];
+			scores[j] = scores[j - 1];
+		}
+		order[j] = w;
+		scores[j] = sc;
+	}
+	for (i = 0; i < nwords; i++)
+		words[i] = order[i];
+	afree(scores, ATEMP);
+	afree(order, ATEMP);
+
+	return (true);
+}
+
+/*-
+ * Is the best candidate so far ahead of the runner-up that it can be
+ * completed on its own? The slack in FLEX_WINNER keeps near ties as a
+ * list -- cli-calculator against c-like on "cl" differ by a single hole --
+ * while a real gap completes outright, as rustlings does over learn-rust
+ * on "ru", whose match starts fifteen characters further in.
+ */
+static bool
+x_flex_clear_winner(int nwords, char **words, const char *query, size_t qlen)
+{
+	const char *a, *b;
+
+	if (nwords < 2)
+		return (true);
+	a = words[0] + x_basename(words[0], NULL);
+	b = words[1] + x_basename(words[1], NULL);
+
+	return (flex_score(b, query, qlen) - flex_score(a, query, qlen) >=
+	    FLEX_WINNER);
+}
