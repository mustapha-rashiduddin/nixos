 /*
  * Apply file globbing to cp and store the matching files in wp. Returns
  * the number of matches found.
+ *
+ * When ignorecase is set we are being called from tab completion, and
+ * match flexibly: see gmatch_flexpat(). Flexible matching is not a
+ * fallback but the whole match -- anything the plain prefix pattern would
+ * have found also contains the typed characters in order, so globbing the
+ * flexible pattern returns the prefix matches plus the rest. Falling back
+ * to it only on failure would hide them: "cl" would complete straight to
+ * cli-calculator/ and never offer c-like/, which is equally plausible.
  */
 int
 glob_str(char *cp, XPtrV *wp, bool markdirs, bool ignorecase)
 {
 	int oldsize = XPsize(*wp);
 	XString xs;
-	char *xp;
+	char *xp, *flexpat;
 
+	if (ignorecase && (flexpat = gmatch_flexpat(cp)) != NULL)
+		cp = flexpat;
+	else
+		flexpat = NULL;
 	Xinit(xs, xp, 256, ATEMP);
 	globit(&xs, &xp, cp, wp, (markdirs ? GF_MARKDIR : GF_NONE) |
 	    (ignorecase ? GF_ICASE : GF_NONE));
 	Xfree(xs, xp);
+	afree(flexpat, ATEMP);
 
 	return (XPsize(*wp) - oldsize);
 }
