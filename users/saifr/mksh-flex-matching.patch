+static void
+glob_path(int flags, const char *pat, XPtrV *wp, const char *lpath)
+{
+	size_t oldsize = XPsize(*wp);
+
+	/* First the plain (case-insensitive) prefix match over all of $PATH. */
+	glob_path1(flags, pat, wp, lpath, false);
+	/*
+	 * Only if that turned up nothing at all do we retry with flexible
+	 * matching. Doing it per $PATH element instead would let a fuzzy
+	 * hit in some unrelated directory hide a real prefix match in
+	 * another one.
+	 */
+	if (XPsize(*wp) == oldsize)
+		glob_path1(flags, pat, wp, lpath, true);
+}
