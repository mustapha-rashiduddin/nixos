+/*
+ * Duplicate the MAGIC-encoded glob pattern p, rewriting its last path
+ * component into its "flexible" variant: a '*' is inserted in front of
+ * every pattern element, so the pattern matches every name containing
+ * the given characters in the same order, anywhere in the name. This is
+ * the flex matching of emacs' ido mode, textmate's "Go to File", fzf
+ * and the like, so e.g. "cl*" becomes "*c*l*", matching both c-like and
+ * cli-calculator.
+ *
+ * The result is a superset of the original pattern -- a name that starts
+ * with the typed text also contains those characters in order -- so this
+ * can replace the plain match rather than merely be a fallback for it.
+ *
+ * Only the last component is rewritten; directory names the user has
+ * already typed are copied over unchanged, which keeps this cheap.
+ *
+ * '*' and '?' are flexible already and are passed through unchanged;
+ * they just keep their meaning, which is exactly what we want here.
+ *
+ * Patterns using constructs we do not want to rewrite in place --
+ * bracket expressions "[...]" and extended globs "*(...)" etc. -- are
+ * rejected: NULL is returned and the caller keeps the plain pattern.
+ * The result is allocated from ATEMP; afree(NULL) is a no-op.
+ */
+char *
+gmatch_flexpat(const char *p)
+{
+	const char *s, *pe, *start;
+	char *r, *d;
+	size_t dirlen;
+
+	pe = strnul(p);
+	for (start = p, s = p; s < pe; s++)
+		if (mksh_cdirsep(*s))
+			start = s + 1;
+	dirlen = start - p;
+	/* worst case: a MAGIC-prefixed '*' per byte of input */
+	d = r = alloc((pe - p) * 2 + 3, ATEMP);
+	memcpy(d, p, dirlen);
+	d += dirlen;
+	for (s = start; s < pe; s++) {
+		if (!ISMAGIC(*s)) {
+			/* plain literal: allow anything in front of it */
+			*d++ = MAGIC;
+			*d++ = '*';
+			*d++ = *s;
+			continue;
+		}
+		{
+			unsigned char c = *++s;
+
+			/* MAGIC + NUL cannot happen */
+			if (!c)
+				break;
+			/* extended globs (0x80 bit) and [...] */
+			if ((c & 0x80) || ord(c) == ORD('[')) {
+				afree(r, ATEMP);
+				return (NULL);
+			}
+			/* '*' and '?' are already flexible */
+			if (ord(c) == ORD('*') || ord(c) == ORD('?')) {
+				*d++ = MAGIC;
+				*d++ = c;
+				continue;
+			}
+			/* escaped literal, e.g. "-" in "foo-*" */
+			*d++ = MAGIC;
+			*d++ = '*';
+			*d++ = MAGIC;
+			*d++ = c;
+		}
+	}
+	*d = '\0';
+
+	return (r);
+}
+
+/*
+ * Rate how well name matches the literal text query, lowest is best.
+ *
+ * Flexible matching answers "does it match?", which on its own cannot tell
+ * a candidate the user obviously meant from one that merely happens to
+ * contain the letters. Ranking can: where the match starts dominates, and
+ * holes in it count for little. So on "ru", rustlings (match at offset 0)
+ * beats learn-rust (offset 3) and Personal_AI_Infrastructure (offset 2,
+ * fifteen holes); on "cl", cli-calculator and c-like land within a point
+ * of each other, which is what marks them as too close to call.
+ *
+ * Returns FLEX_NOMATCH if name does not contain query at all.
+ */
+int
+flex_score(const char *name, const char *query, size_t qlen)
+{
+	const char *s = name, *hit;
+	size_t i, off, pos = 0, last = 0, holes = 0;
+	bool seen = false;
+
+	for (i = 0; i < qlen; i++) {
+		for (hit = s; *hit; hit++)
+			if (gmatch_same((unsigned char)*hit,
+			    (unsigned char)query[i], true))
+				break;
+		if (!*hit)
+			return (FLEX_NOMATCH);
+		off = hit - name;
+		if (!seen) {
+			pos = off;
+			last = off;
+			seen = true;
+		} else
+			holes += off - last - 1;
+		last = off;
+		s = hit + 1;
+	}
+
+	return ((int)(pos * FLEX_POS_W) + (int)holes);
+}
