+/* Modes asked for that we do not implement, that we have already complained
+ * about. See the default case in tsetmode() for why this is tracked. */
+static struct unseen_mode {
+	int mode;
+	struct unseen_mode *next;
+} *unseen_modes;
+
+/* Whether a diagnostic has already been printed for this mode. The list is
+ * walked once per complaint rather than once per byte, and holds only the
+ * handful of distinct modes an app has asked about, so this is negligible
+ * next to the handling it guards. */
+static int
+already_seen(int mode)
+{
+	struct unseen_mode *m;
+
+	for (m = unseen_modes; m; m = m->next)
+		if (m->mode == mode)
+			return 1;
+	return 0;
+}
+
+static void
+remember(int mode)
+{
+	struct unseen_mode *m = malloc(sizeof *m);
+
+	if (!m)
+		return;
+	m->mode = mode;
+	m->next = unseen_modes;
+	unseen_modes = m;
+}
+
